# SimPal .env example
#
# Quick start:
# 1) Copy this file to `.env` (for local runs from this repo), OR to `~/.simpal/.env` (for launchd/systemd daemons).
# 2) Fill only the values you use.
# 3) Keep real secrets out of git.
#
# Env-source precedence for environment variables (highest -> lowest):
# process env, ./.env, ~/.simpal/.env, then simpal.json `env` block.
# Existing non-empty process env vars are not overridden by dotenv/config env loading.
# Note: direct config keys (for example `gateway.auth.token` or channel tokens in simpal.json)
# are resolved separately from env loading and often take precedence over env fallbacks.
#
# SIMPAL_* vars take precedence over OPENCLAW_* vars (kept for backward compatibility).

# -----------------------------------------------------------------------------
# Gateway auth + paths
# -----------------------------------------------------------------------------
# Recommended if the gateway binds beyond loopback.
SIMPAL_GATEWAY_TOKEN=change-me-to-a-long-random-token
# Example generator: openssl rand -hex 32
# OPENCLAW_GATEWAY_TOKEN=  # legacy alias (still works)

# Optional alternative auth mode (use token OR password).
# SIMPAL_GATEWAY_PASSWORD=change-me-to-a-strong-password
# OPENCLAW_GATEWAY_PASSWORD=  # legacy alias

# Optional path overrides (defaults shown for reference).
# SIMPAL_STATE_DIR=~/.simpal
# OPENCLAW_STATE_DIR=~/.openclaw  # legacy alias
# SIMPAL_CONFIG_PATH=~/.simpal/simpal.json
# SIMPAL_HOME=~
# OPENCLAW_HOME=~  # legacy alias

# Optional: import missing keys from your login shell profile.
# SIMPAL_LOAD_SHELL_ENV=1
# OPENCLAW_LOAD_SHELL_ENV=1  # legacy alias
# SIMPAL_SHELL_ENV_TIMEOUT_MS=15000
# OPENCLAW_SHELL_ENV_TIMEOUT_MS=15000  # legacy alias

# SimPal-specific feature flags
# SIMPAL_NIX_MODE=1            # run in Nix-managed config mode
# OPENCLAW_NIX_MODE=1          # legacy alias

# -----------------------------------------------------------------------------
# Model provider API keys (set at least one)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# OPENCLAW_LIVE_OPENAI_KEY=sk-...
# OPENCLAW_LIVE_ANTHROPIC_KEY=sk-ant-...
# OPENCLAW_LIVE_GEMINI_KEY=...
# OPENAI_API_KEY_1=...
# ANTHROPIC_API_KEY_1=...
# GEMINI_API_KEY_1=...
# GOOGLE_API_KEY=...
# OPENAI_API_KEYS=sk-1,sk-2
# ANTHROPIC_API_KEYS=sk-ant-1,sk-ant-2
# GEMINI_API_KEYS=key-1,key-2

# Optional additional providers
# ZAI_API_KEY=...
# AI_GATEWAY_API_KEY=...
# MINIMAX_API_KEY=...
# SYNTHETIC_API_KEY=...

# -----------------------------------------------------------------------------
# Channels (only set what you enable)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Optional channel env fallbacks
# MATTERMOST_BOT_TOKEN=...
# MATTERMOST_URL=https://chat.example.com
# ZALO_BOT_TOKEN=...
# OPENCLAW_TWITCH_ACCESS_TOKEN=oauth:...

# -----------------------------------------------------------------------------
# Tools + voice/media (optional)
# -----------------------------------------------------------------------------
# BRAVE_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
# FIRECRAWL_API_KEY=...

# ELEVENLABS_API_KEY=...
# XI_API_KEY=...  # alias for ElevenLabs
# DEEPGRAM_API_KEY=...
